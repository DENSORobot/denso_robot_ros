		<inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
	</inertial>
</link>
<joint name="${prefix}joint_2" type="revolute">
	<parent link="${prefix}J1"/>
	<child link="${prefix}J2"/>
	<origin rpy="0.000000 0.000000 0.000000" xyz="0.030000 0.000000 0.197500"/>
	<axis xyz="-0.000000 1.000000 -0.000000"/>
	<limit effort="1" lower="-1.74532925199433" upper="2.35619449019234" velocity="1"/>
	<dynamics damping="0" friction="0"/>
</joint>
<transmission name="${prefix}trans_2">
	<type>transmission_interface/SimpleTransmission</type>
	<joint name="${prefix}joint_2">
		<hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
	</joint>
	<actuator name="${prefix}motor_2">
		<hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
		<mechanicalReduction>1</mechanicalReduction>
	</actuator>
</transmission>
